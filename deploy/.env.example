SPINDLE_TZ=Europe/Warsaw

# Personal access token from https://www.discogs.com/settings/developers
SPINDLE_DISCOGS_TOKEN=

# Optional, used as a fallback source for album length
SPINDLE_LASTFM_KEY=

# Optional, enables the Home Assistant integration
SPINDLE_MQTT_URL=
SPINDLE_MQTT_USERNAME=
SPINDLE_MQTT_PASSWORD=

# Set to true when Spindle is served over HTTPS
SPINDLE_SECURE_COOKIES=false

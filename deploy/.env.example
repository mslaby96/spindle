SPINDLE_TZ=Europe/Warsaw

# Personal access token from https://www.discogs.com/settings/developers
SPINDLE_DISCOGS_TOKEN=

# Optional, used as a fallback source for album length
SPINDLE_LASTFM_KEY=

# Optional, enables the Home Assistant integration
SPINDLE_MQTT_URL=
SPINDLE_MQTT_USERNAME=
SPINDLE_MQTT_PASSWORD=

# Backups: the folder on this machine they are written to, how often, and how many to keep.
# SPINDLE_BACKUP_EVERY=off turns the automatic ones off.
SPINDLE_BACKUP_PATH=./backups
SPINDLE_BACKUP_EVERY=24h
SPINDLE_BACKUP_KEEP=7

# Behind a reverse proxy that does HTTPS: its address or network, e.g. 172.16.0.0/12
SPINDLE_TRUSTED_PROXIES=

# The login cookie is secure whenever the browser uses HTTPS; true makes it so always
SPINDLE_SECURE_COOKIES=false
